# Environment variables for notqueue.
# Copy this file to `.env.local` and fill in the values. Never commit real secrets.
# Variables are added here by the features that need them (e.g. F-FOUND-DB, F-FOUND-PIPELINE).

# Sentry (EU, F-FOUND-PIPELINE). Leave empty locally: without a DSN nothing is sent.
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only, for source-map upload. Set in Vercel, not needed locally.
SENTRY_AUTH_TOKEN=

# Database (F-FOUND-DB, ADR-0013). Locally both may stay empty: `pnpm db:migrate`
# and the tests then use the local stack from `pnpm db:start` (port 54322).
# Runtime: Supavisor transaction pooler (port 6543). Set in Vercel per environment.
DATABASE_URL=
# Optional pool size per function instance (default 5).
DATABASE_POOL_MAX=
# Migrations: Supavisor session pooler. Set in the GitHub environments, not in Vercel.
MIGRATIONS_DATABASE_URL=
