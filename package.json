{
  "name": "notqueue",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "check:boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:preview": "playwright test --config playwright.preview.config.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm check:boundaries && pnpm docs:check && pnpm i18n:check && pnpm test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/infra/db/migrate.ts",
    "db:reset": "supabase db reset && pnpm db:migrate",
    "prepare": "husky",
    "api:spec": "tsx src/api/spec.ts",
    "docs:check": "tsx tools/docs-check/cli.ts",
    "docs:map": "tsx tools/docs-check/map-cli.ts",
    "i18n:check": "tsx tools/i18n-check/cli.ts"
  },
  "dependencies": {
    "@hono/zod-openapi": "1.6.3",
    "@sentry/nextjs": "11.8.0",
    "@vercel/functions": "3.10.6",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.16",
    "next": "16.4.4",
    "next-intl": "4.14.10",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@formatjs/icu-messageformat-parser": "3.5.23",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.3",
    "dependency-cruiser": "^18.5.0",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.4",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "3.0.0",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
