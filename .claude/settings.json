{
  "permissions": {
    "ask": ["Bash(git push *)", "Bash(gh pr create *)", "Bash(gh pr merge *)"],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./.env.test)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "input=$(cat); printf '%s' \"$input\" | grep -q 'gh pr create' || exit 0; cd \"$CLAUDE_PROJECT_DIR\" && printf '%s' \"$input\" | pnpm -s docs:map --hook 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "Checking the docs review"
          }
        ]
      }
    ]
  }
}
